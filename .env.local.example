# 구글 시트 "웹에 게시(CSV)" 또는 "링크가 있는 모든 사용자"로 공유한 뒤 얻은 URL
PRODUCTS_CSV_URL=https://docs.google.com/spreadsheets/d/여기에_상품마스터_시트ID/export?format=csv&gid=0
RESERVATIONS_CSV_URL=https://docs.google.com/spreadsheets/d/여기에_예약기록_시트ID/export?format=csv&gid=0

# scripts/AppsScript.gs 를 예약기록 시트에 배포하고 나온 웹 앱 URL
ORDER_WEBHOOK_URL=https://script.google.com/macros/s/여기에_배포된_ID/exec

# 주문 완료 화면에 보여줄 입금 계좌 정보 (NEXT_PUBLIC_ 접두사 필수 — 브라우저에 노출되는 값)
NEXT_PUBLIC_BANK_NAME=00은행
NEXT_PUBLIC_BANK_ACCOUNT=000-0000-0000
NEXT_PUBLIC_BANK_HOLDER=단단상회

# 배송비는 여기서 설정하지 않습니다 — 상품마스터 시트의 "shiping fee" 열에서 상품별로 설정하세요.

# 회원(로그인) 시트 CSV 게시 URL
MEMBERS_CSV_URL=https://docs.google.com/spreadsheets/d/여기에_회원_시트ID/export?format=csv&gid=0

# scripts/MemberSignupAppsScript.gs 를 회원 시트에 배포하고 나온 웹 앱 URL
MEMBER_SIGNUP_WEBHOOK_URL=https://script.google.com/macros/s/여기에_배포된_ID/exec

# 로그인 세션 쿠키 서명용 비밀키 — 아무 랜덤 문자열이나 32자 이상으로. 노출되면 안 됨 (NEXT_PUBLIC_ 아님)
SESSION_SECRET=여기에_랜덤한_긴_문자열
